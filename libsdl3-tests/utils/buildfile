import libs = libsdl3%lib{sdl3}

# sdltests_utils: upstream's own internal utility object library, shared
# across test executables (upstream/test/CMakeLists.txt:
# add_library(sdltests_utils OBJECT testutils.c)). Not exported: only ever
# linked into this package's own test executable. libue{}, not libul{},
# because the consumer is an executable, not another library.
#
libue{sdltests_utils}: {h c}{testutils} $libs

# The permissive license covering testutils.* specifically (upstream/test/
# LICENSE.txt, more permissive than the package's own top-level zlib
# LICENSE.txt). Not part of the installed surface, so install = false.
#
./: legal{LICENSE.txt}: install = false
