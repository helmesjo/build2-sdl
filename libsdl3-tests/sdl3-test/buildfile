# SDL3_test static helper (headers are public in libsdl3: <SDL3/SDL_test*.h>).
#

import intf_libs = libsdl3%lib{sdl3}

# Static-only matches upstream (SDL3_test is always a static archive).
#
lib{sdl3-test}: bin.lib = static

lib{sdl3-test}: {h c}{*} $intf_libs

# Headers from libsdl3 (interface). Private internal header not installed.
#
c.poptions =+ "-I$out_root" "-I$src_root"

lib{sdl3-test}:
{
  c.export.poptions =
  c.export.libs = $intf_libs
}

if $version.pre_release
  lib{sdl3-test}: bin.lib.version = "-$version.project_id"
else
  lib{sdl3-test}: bin.lib.version = "-$version.major.$version.minor"

# No install of private implementation header. Public SDL_test*.h live in
# libsdl3.
#
h{*}: install = false
