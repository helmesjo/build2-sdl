import intf_libs = libsdl3%lib{sdl3}

# SDL3_test: upstream's public test-helper library. Its headers are public
# but installed as part of libsdl3 (<SDL3/SDL_test*.h>), not from this
# package (upstream/src/test/ ships only the .c implementations and one
# private header, SDL_test_internal.h), so this is a utility library:
# static-only and never installed or exported as a package artifact,
# matching upstream, consumed only by this package's own test executable.
#
libue{sdl3-test}: {h c}{*} $intf_libs

# Headers from libsdl3 (interface).
#
c.poptions =+ "-I$out_root" "-I$src_root"

libue{sdl3-test}:
{
  c.export.libs = $intf_libs
}
