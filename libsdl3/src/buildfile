intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{sdl3}: $pub/{$pub_hdrs}

# --- sources ---
#
# Prefer path/to/dir/c{*} (path before target type) for granularity.
# Exclude SDL_test (separate package). Platform backends are gated below.
#

# Root-level units.
#
lib{sdl3}: {h c}{*}

# Core portable subsystems (non-platform trees).
#
lib{sdl3}: \
