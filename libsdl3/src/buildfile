lib{sdl3}: \
  filesystem/posix/{h c}{*} \
  process/posix/{h c}{*}: include = $posix

# --- platform backends (Windows) ---
#
windows = ($c.target.class == 'windows')

lib{sdl3}: \
  video/windows/{h c}{*} \
  audio/wasapi/{h c}{*} \
  audio/directsound/{h c}{*} \
  core/windows/{h c}{*} \
  filesystem/windows/{h c}{*} \
