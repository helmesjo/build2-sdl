  locale/windows/{h c}{*} \
  misc/windows/{h c}{*} \
  power/windows/{h c}{*} \
  thread/windows/{h c}{*} \
  time/windows/{h c}{*} \
  timer/windows/{h c}{*} \
  loadso/windows/{h c}{*} \
  main/windows/{h c}{*} \
  process/windows/{h c}{*} \
  dialog/windows/{h c}{*} \
  tray/windows/{h c}{*} \
  camera/mediafoundation/{h c}{*} \
  sensor/windows/{h c}{*} \
  render/direct3d/{h c}{*} \
  render/direct3d11/{h c}{*} \
  render/direct3d12/{h c}{*} \
  gpu/d3d11/{h c}{*} \
  gpu/d3d12/{h c}{*} \
  io/windows/{h c}{*}: include = $windows

# Windows also uses selected thread/generic sources (not the full tree:
# SDL_syssem.c is windows/SDL_syssem.c, and generic/SDL_syssem.c is only
# #included from the pthread backend).
#
lib{sdl3}: \
  thread/generic/{h c}{SDL_syscond SDL_sysrwlock}: include = $windows

lib{sdl3}: $impl_libs $intf_libs

# Private headers as ordinary library prerequisites (not adhoc). Same as the
# packaging guide {h c}{**} pattern: headers are not compiled, but must be
# prereqs for rebuilds and for dist through the upstream directory symlinks.
# Recursive so platform-subdir headers (e.g. hidapi/windows/*.h) are included
# even when those dirs are not on the compile list.
#
lib{sdl3}: h{**}

# .c files that are only #include'd into other TUs (never their own object).
# adhoc is required here so they are not treated as linkable translation units.
#
lib{sdl3}: \
  hidapi/mac/c{hid} \
  hidapi/linux/c{hid} \
  hidapi/windows/c{hid} \
  hidapi/windows/c{hidapi_descriptor_reconstruct} \
  hidapi/libusb/c{hid} \
  hidapi/netbsd/c{hid} \
  thread/generic/c{SDL_syssem}: include = adhoc

# --- private generated SDL_build_config.h (libbuild2-autoconf) ---
#
# Process upstream's CMake template with the autoconf module (cmake flavor).
#
# Resolution order for each #cmakedefine name (module default):
#   1. autoconf.substitutions -- platform feature maps (SDL_* drivers, etc.)
#   2. target-specific variables -- optional package header probes
#   3. project checks in build/autoconf/checks/
#   4. libbuild2-autoconf builtin checks
#
# HAVE_* for libc/compiler features are never hardcoded in the maps. They come
# from (3)/(4). Optional system-library SDL_* drivers and package headers are
# (2): see apply-system-feature-probes.build and apply-system-header-probes.build.
#
using autoconf

switch $c.target.class
{
  case 'macos'
    source $src_base/config/subs-macos.build

  case 'windows'
    source $src_base/config/subs-windows.build

  case 'linux'
  case 'bsd'
    source $src_base/config/subs-linux.build

  default
    source $src_base/config/subs-linux.build
}

# Platform substitution maps and probe helpers (must all ship in dist).
#
./: file{config/**}

h{build_config/SDL_build_config}: \
  fsdir{build_config} \
  ../include/build_config/in{SDL_build_config.h.cmake}
{
  autoconf.flavor = cmake
  autoconf.substitutions = $config_subs
}

# Optional package headers (dbus, libusb, ...) and optional system-lib drivers
# (X11, ALSA, ...): $c.find_system_header and conventional DYNAMIC SONAMEs.
#
source $src_base/config/apply-system-header-probes.build
source $src_base/config/apply-system-feature-probes.build

lib{sdl3}: h{build_config/SDL_build_config}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/
out_pfx_cfg = [dir_path] $out_root/src/build_config/

c.poptions =+ "-I$out_pfx_cfg" "-I$out_pfx_src" "-I$src_pfx_src" \
              "-I$out_pfx_inc" "-I$src_pfx_inc" \
              "-I$src_pfx_src/video/khronos" \
              -DUSING_GENERATED_CONFIG_H \
              -D_GNU_SOURCE=1

# Apple frameworks (match upstream CMake link line on macOS).
#
if ($c.target.class == 'macos')
{
  # Upstream requires Objective-C ARC for Cocoa backends.
  #
  c.coptions += -fobjc-arc

  c.libs += -framework CoreMedia -framework CoreVideo -framework Cocoa \
            -framework IOKit -framework ForceFeedback -framework Carbon \
            -framework CoreAudio -framework AudioToolbox -framework AVFoundation \
            -framework Foundation -framework GameController -framework Metal \
            -framework QuartzCore \
            -weak_framework CoreHaptics -weak_framework UniformTypeIdentifiers \
            -lpthread -lm
}

if ($c.target.class == 'linux' || $c.target.class == 'bsd')
  c.libs += -lpthread -lm -ldl

if ($c.target.class == 'windows')
{
  if ($c.target.system == 'mingw32')
    c.libs += -luser32 -lgdi32 -lwinmm -limm32 -lole32 -loleaut32 \
              -lversion -luuid -ladvapi32 -lsetupapi -lshell32
  else
    c.libs += user32.lib gdi32.lib winmm.lib imm32.lib ole32.lib oleaut32.lib \
              version.lib uuid.lib advapi32.lib setupapi.lib shell32.lib
}

# Export options.
#
lib{sdl3}:
{
  c.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc"
  c.export.libs = $intf_libs
}

if $version.pre_release
  lib{sdl3}: bin.lib.version = "-$version.project_id"
else
  lib{sdl3}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
h{*}: install = false
