# Uncomment to suppress warnings coming from external libraries.
#
#c.internal.scope = current

using c
using c.objc
using c.predefs

# Objective-C ARC and the Cocoa backend's use of the modern Apple SDK
# headers are Clang-only. Fail early with a clear diagnostic instead of
# letting an unsupported compiler hit a raw driver error deep in a
# compile invocation (matches upstream's own check_c_compiler_flag +
# FATAL_ERROR guard in CMakeLists.txt).
#
if ($c.target.class == 'macos' && $c.id != 'clang' && $c.id != 'clang-apple')
  fail 'libsdl3 requires Clang on macOS (Objective-C ARC)'

h{*}: extension = h
c{*}: extension = c
m{*}: extension = m

# Windows-only GameInput support (see src/buildfile) needs three genuine
# C++ translation units from upstream. Every other source in this library
# stays C. These TUs only ever include the project's plain .h headers
# (already mapped to h{} above, shared with C, as upstream itself does),
# so hxx{} is never used and must not also claim the .h extension: that
# would make it ambiguous with h{}'s existing mapping for every consumer
# resolving a header dependency against this project. Sources use
# upstream's own .cpp rather than the cxx module's .cxx default.
#
cxx.std = latest

using cxx

cxx{*}: extension = cpp

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target
