: 1
name: libsdl3-examples
version: 3.4.12-a.0.z
type: exe
language: c
project: sdl
summary: cross-platform multimedia C library (examples)
license: other: public domain ; Released into the public domain.
description-file: README.md
package-description-file: PACKAGE-README.md
changes-file: WhatsNew.txt
url: https://www.libsdl.org/
doc-url: https://wiki.libsdl.org/
src-url: https://github.com/libsdl-org/SDL
email: slouken@libsdl.org
package-url: https://github.com/build2-packaging/SDL
package-email: packaging@build2.org ; Mailing list.
depends: * build2 >= 0.18.0
depends: * bpkg >= 0.18.0

# CI configuration (keep aligned with libsdl3).
#
# Examples build on the same platform matrix as the library and the test
# suite; they only ever link against SDL3.
#

builds: -freebsd
builds: -linux
builds: -macos
builds: -windows
builds: -bindist

macos-clang-builds: macos
macos-clang-build-include: macos_*-clang**
macos-clang-build-exclude: **

windows-msvc-builds: windows
windows-msvc-build-include: windows*-msvc**
windows-msvc-build-exclude: **

debian-build-config:
\
sys:libx11
sys:libxext
sys:libxcursor
sys:libxi
sys:libxfixes
sys:libxrandr
sys:libxss
sys:libxtst
sys:libxkbcommon
sys:libgl
sys:libasound2
sys:libpulse
sys:libpipewire-0.3
sys:libdrm
sys:libgbm
sys:libudev
sys:libdbus-1
\
debian-builds: sys
debian-builds: -static
debian-builds: -bindist
debian-build-include: linux_debian*-**
debian-build-exclude: **

# Fedora/RHEL: every Fedora and RHEL bot on this deployment is
# bindist-only (see https://ci.cppget.org/?build-configs=all). A
# bindist-tagged bot verifies that this package's own generated binary
# redistributable artifact installs cleanly, a different mechanism from
# resolving sys: dependencies for a from-source build, so there is no
# bot here a Fedora-style sys: dependency config could ever run on.
#
fedora-builds: none
